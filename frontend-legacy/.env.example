# ===========================================
# Mead Security — Frontend Environment Variables
# ===========================================
# Copy this to .env and fill in your values.

# Backend API Configuration
# Leave empty to use Vite proxy in development (recommended)
VITE_API_URL=
# For production: VITE_API_URL=https://api.meadsecurity.co.uk/api/v1

# Google Maps API Key for venue location features
# Enable: Maps JavaScript API, Geocoding API, Places API
VITE_GOOGLE_MAPS_API_KEY=

# GetAddress.io API Key for UK property-level address lookup
VITE_GETADDRESS_API_KEY=

# Sentry Error Tracking (https://sentry.io)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# PostHog Analytics (https://posthog.com)
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
