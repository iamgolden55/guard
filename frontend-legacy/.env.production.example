# Production Environment Variables
# Copy this file to .env.production for production builds

# Backend API Configuration (REQUIRED)
# Replace with your production API URL
VITE_API_URL=https://api.yourdomain.com/api/v1

# Google Maps API Key (REQUIRED)
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key

# GetAddress.io API Key (OPTIONAL)
# For UK property-level address lookup
VITE_GETADDRESS_API_KEY=your_production_getaddress_api_key

# Development mode: bypass location verification (should be false in production)
VITE_BYPASS_LOCATION_CHECK=false
