# Production Environment Variables
# Vite reads this automatically for production builds (npm run build).

# Backend API URL — direct to Render. The Vercel rewrite in vercel.json is a
# fallback; we set the URL explicitly because Vercel rewrites don't proxy POST
# bodies cleanly for our auth flow.
VITE_API_URL=https://mead-security-api.onrender.com

# Sentry — set VITE_SENTRY_DSN as a Vercel env var (kept out of git).
VITE_SENTRY_ENVIRONMENT=production

# Mapbox token for venue autocomplete — set as a Vercel env var (URL-restricted).
# VITE_MAPBOX_TOKEN=
