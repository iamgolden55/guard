# Base URL for API calls. Leave blank in dev to use the Vite proxy
# (which forwards /api → http://localhost:8000). Set for production builds.
VITE_API_URL=

# Mapbox public access token for venue address autocomplete.
# Sign up free at https://account.mapbox.com, copy the default public token
# (starts with pk.), then URL-restrict it in the dashboard for safety.
# Free tier covers 100k requests/month. Leave blank to disable autocomplete
# (the venue form falls back to manual entry).
VITE_MAPBOX_TOKEN=
