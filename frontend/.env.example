# Google Maps API Key for venue location features
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Make sure to enable the following APIs:
# - Maps JavaScript API
# - Geocoding API
# - Places API (for address autocomplete)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GetAddress.io API Key for UK property-level address lookup
# Get your API key from: https://getaddress.io
# This provides access to Royal Mail PAF data for accurate UK addresses
# Free tier: 20 lookups/day, Paid plans start from £5/month for 1000 lookups
VITE_GETADDRESS_API_KEY=your_getaddress_api_key_here

# Examples:
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyBOti4mM-6x9WDnZIjIeyEU21OpBXqWBgw
# VITE_GETADDRESS_API_KEY=abc123def456ghi789