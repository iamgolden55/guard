# Mobile App Environment Configuration Example
# Copy this to .env and update with your settings

# Backend API Configuration
# Find your IP with: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)
API_BASE_URL=http://YOUR_IP_HERE:8000

# Environment
NODE_ENV=development

# ===================================================================
# EXPO PROJECT ID (Optional - Only needed for Development Builds)
# ===================================================================
# When using Expo Go: Leave this commented out or use placeholder
# When building: Run "eas project:init" to get your project ID
#
# After running "eas project:init", copy the project ID here:
# EXPO_PROJECT_ID=12345678-1234-1234-1234-123456789abc
#
# What this enables:
# ✅ Development builds (eas build)
# ✅ Server-sent push notifications (full push support)
# ✅ Over-the-air updates (eas update)
# ✅ Build automation and CI/CD
#
# What works WITHOUT this:
# ✅ Expo Go development
# ✅ Local notifications (shift reminders work perfectly!)
# ✅ All app features except remote push notifications
#
# See DEVELOPMENT_BUILD_SETUP.md for complete guide
# ===================================================================
