# WhatsApp AI Integration Configuration
# Copy this file to .env.whatsapp and fill in your credentials

# ============================================
# TWILIO CONFIGURATION (Recommended)
# ============================================
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# META WHATSAPP BUSINESS API (Enterprise)
# ============================================
# Get these from: https://developers.facebook.com/
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_verify_token_here

# ============================================
# SECURITY CONFIGURATION (IMPORTANT!)
# ============================================
# Generate secure secret: openssl rand -base64 32
WHATSAPP_WEBHOOK_SECRET=your_very_secure_webhook_secret_here_min_32_chars

# Authorized phone numbers (comma-separated, E.164 format)
WHATSAPP_ALLOWED_NUMBERS=+1234567890,+0987654321,+44XXXXXXXXXX

# Session timeout (hours)
WHATSAPP_SESSION_TIMEOUT=8

# Rate limiting
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_RATE_LIMIT_PER_HOUR=200

# ============================================
# SERVER CONFIGURATION
# ============================================
# WhatsApp webhook server
WHATSAPP_PORT=5000
WHATSAPP_HOST=0.0.0.0

# AI agents endpoint
AI_ENDPOINT=http://localhost:8001/query

# Debug mode (set to false in production)
FLASK_DEBUG=false

# ============================================
# WEBHOOK CONFIGURATION
# ============================================
# Your webhook URL (must be HTTPS in production)
# Example: https://yourdomain.com/webhook/whatsapp
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp

# ============================================
# OPTIONAL: NGROK FOR TESTING
# ============================================
# For local testing, you can use ngrok:
# 1. Install ngrok: https://ngrok.com/
# 2. Run: ngrok http 5000
# 3. Use the HTTPS URL for webhook configuration
# Example: https://abc123.ngrok.io/webhook/whatsapp