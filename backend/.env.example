# ===========================================
# Mead Security — Backend Environment Variables
# ===========================================
# Copy this to .env and fill in your values.
# NEVER commit .env with real credentials.

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (Docker defaults: meadsecurity/meadsecurity/meadsecurity)
DB_NAME=security_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (used for cache, Celery broker, and Channels)
REDIS_URL=redis://localhost:6379/0

# Celery (override if using separate Redis DBs)
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google Maps
GOOGLE_MAPS_API_KEY=

# Finance Integrations Encryption Key
FINANCE_ENCRYPTION_KEY=

# Xero OAuth
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/admin/finance-integrations/oauth-callback

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/admin/finance-integrations/oauth-callback

# Sage OAuth
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3000/admin/finance-integrations/oauth-callback

# Email (Brevo SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Info <info@meadsecurity.co.uk>
HR_FROM_EMAIL=HR <hr@meadsecurity.co.uk>
INFO_FROM_EMAIL=Info <info@meadsecurity.co.uk>
PAYMENT_FROM_EMAIL=Payments <payment@meadsecurity.co.uk>

# Document storage — private Cloudflare R2 bucket (S3 API)
# Leave all four empty to keep uploads on local disk (fine for Docker dev).
# Set all four or none: a partial set fails at startup. In production they are
# required — Render's disk is wiped on every deploy, so uploads are refused
# without them. Use a separate dev bucket, never the production one.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket
R2_LOCATION=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Social Auth
APPLE_CLIENT_ID=com.meadsecurity.staffapp

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
