{
  "name": "Chat → Venue/Code Updater (Push)",
  "nodes": [
    {
      "parameters": {
        "path": "chat-ingest",
        "options": {
          "responseData": { "response": "json" },
          "responseCode": 200
        }
      },
      "id": "Webhook_Chat",
      "name": "Webhook (Chat Events)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "functionCode": "const hdr = $json.headers || {};\nif (hdr['x-chat-signature'] !== 'YOUR_WEBHOOK_SECRET') {\n  throw new Error('Unauthorized webhook source');\n}\n// Google Chat event payload may come under body; normalize\nconst body = $json.body || $json;\nreturn [{ event: body }];"
      },
      "id": "VerifySecret",
      "name": "Verify Secret & Normalize",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "resource": "chatCompletion",
        "operation": "create",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You extract structured data from noisy chat messages.\nGiven a message text, output JSON with keys:\nintent in [\"NEW_CODE\",\"CODE_CHANGE\",\"NEW_VENUE\",\"MISC\"],\nvenue_name, room, code, postcode, effective_date (YYYY-MM-DD or null).\nReturn ONLY valid JSON."
          },
          {
            "role": "user",
            "content": "Text: {{$json.event.message?.text || $json.event.text || ''}}"
          }
        ]
      },
      "id": "AI_Extract",
      "name": "AI: Extract Entities",
      "type": "n8n-nodes-base.openai",
      "typeVersion": 4,
      "position": [700, 200],
      "credentials": { "openAIApi": { "id": "OpenAI_Account", "name": "OpenAI_Account" } }
    },
    {
      "parameters": {
        "functionCode": "let parsed;\ntry { parsed = JSON.parse($json.choices[0].message.content); } catch(e){ throw new Error('AI parse failed: ' + $json.choices[0].message.content); }\nreturn [parsed];"
      },
      "id": "ParseAI",
      "name": "Parse AI JSON",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [950, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$json.intent}}", "operation": "in", "value2": "NEW_CODE,CODE_CHANGE,NEW_VENUE" }
          ]
        }
      },
      "id": "If_Useful",
      "name": "IF Intent Useful",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "venues",
        "columns": "id,name,room,postcode",
        "filters": "name=eq.{{$json.venue_name}}&room=is.{{$json.room || null}}&postcode=is.{{$json.postcode || null}}",
        "options": {}
      },
      "id": "SB_FindVenue",
      "name": "Supabase: Find Venue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [1450, 120],
      "credentials": { "supabaseApi": { "id": "Supabase_Service_Role", "name": "Supabase_Service_Role" } }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "venues",
        "columns": "name,room,postcode,active",
        "values": "{{$json.venue_name}},{{$json.room || null}},{{$json.postcode || null}},true",
        "options": {}
      },
      "id": "SB_CreateVenue",
      "name": "Supabase: Create Venue (if missing)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [1700, 80],
      "credentials": { "supabaseApi": { "id": "Supabase_Service_Role", "name": "Supabase_Service_Role" } }
    },
    {
      "parameters": {
        "functionCode": "// Pick venue_id from found or created\nconst found = items[0].json.rows?.[0];\nconst created = $items(\"Supabase: Create Venue (if missing)\", 0, 0)?.json?.rows?.[0];\nconst venue_id = (found?.id) || (created?.id);\nreturn [{venue_id}];"
      },
      "id": "VenueId",
      "name": "Resolve venue_id",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1920, 120]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "venue_codes",
        "filters": "venue_id=eq.{{$json.venue_id}}&valid_to=is.null",
        "values": "valid_to=now()",
        "options": {}
      },
      "id": "SB_CloseOld",
      "name": "Supabase: Close old active code",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [2120, 80],
      "credentials": { "supabaseApi": { "id": "Supabase_Service_Role", "name": "Supabase_Service_Role" } }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "venue_codes",
        "columns": "venue_id,code,valid_from,source_message_id",
        "values": "{{$json.venue_id}},{{$('Parse AI JSON').item.json.code}},{{$('Parse AI JSON').item.json.effective_date || new Date().toISOString()}},{{$('Verify Secret & Normalize').item.json.event.message?.name || ''}}",
        "options": {}
      },
      "id": "SB_InsertCode",
      "name": "Supabase: Insert new code",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [2350, 80],
      "credentials": { "supabaseApi": { "id": "Supabase_Service_Role", "name": "Supabase_Service_Role" } }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "audit_log",
        "columns": "event,payload",
        "values": "'CHAT_CODE_UPDATE',{{$json}}"
      },
      "id": "SB_Audit",
      "name": "Supabase: Audit log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [2570, 80],
      "credentials": { "supabaseApi": { "id": "Supabase_Service_Role", "name": "Supabase_Service_Role" } }
    },
    {
      "parameters": { "responseBody": "{\"status\":\"ok\"}" },
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2800, 200]
    }
  ],
  "connections": {
    "Webhook (Chat Events)": { "main": [[{ "node": "Verify Secret & Normalize", "type": "main", "index": 0 }]] },
    "Verify Secret & Normalize": { "main": [[{ "node": "AI: Extract Entities", "type": "main", "index": 0 }]] },
    "AI: Extract Entities": { "main": [[{ "node": "Parse AI JSON", "type": "main", "index": 0 }]] },
    "Parse AI JSON": { "main": [[{ "node": "IF Intent Useful", "type": "main", "index": 0 }]] },
    "IF Intent Useful": {
      "main": [
        [{ "node": "Supabase: Find Venue", "type": "main", "index": 0 }],
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Supabase: Find Venue": { "main": [[{ "node": "Supabase: Create Venue (if missing)", "type": "main", "index": 0 }, { "node": "Resolve venue_id", "type": "main", "index": 0 }]] },
    "Supabase: Create Venue (if missing)": { "main": [[{ "node": "Resolve venue_id", "type": "main", "index": 0 }]] },
    "Resolve venue_id": { "main": [[{ "node": "Supabase: Close old active code", "type": "main", "index": 0 }]] },
    "Supabase: Close old active code": { "main": [[{ "node": "Supabase: Insert new code", "type": "main", "index": 0 }]] },
    "Supabase: Insert new code": { "main": [[{ "node": "Supabase: Audit log", "type": "main", "index": 0 }]] },
    "Supabase: Audit log": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}
