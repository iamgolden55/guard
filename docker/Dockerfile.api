FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# System dependencies for psycopg2, reportlab (PDF), and Pillow (images)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (split base/dev/prod)
COPY backend/requirements/base.txt requirements/base.txt
COPY backend/requirements/dev.txt requirements/dev.txt
COPY backend/requirements/prod.txt requirements/prod.txt

ARG INSTALL_DEV=true
RUN if [ "$INSTALL_DEV" = "true" ]; then \
        pip install --no-cache-dir -r requirements/dev.txt; \
    else \
        pip install --no-cache-dir -r requirements/prod.txt; \
    fi

COPY backend/ .

EXPOSE 8000

CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "core.asgi:application"]
